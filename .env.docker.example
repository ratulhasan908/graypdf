# Copy this file to .env (next to docker-compose.yml) and change the values.

# Required. Use long random strings.
SECRET_KEY=replace-me-with-a-long-random-string
DB_PASSWORD=replace-me-with-a-long-random-password

# Your public addresses. These defaults are for trying it on your own computer.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For a local trial use DEBUG=True and ENVIRONMENT=development.
# On a real server use False and production, behind HTTPS.
DEBUG=True
ENVIRONMENT=development

# Set to 1 behind one reverse proxy such as nginx or Cloudflare, so guest
# limits see each visitor's real IP address.
TRUSTED_PROXY_COUNT=0
